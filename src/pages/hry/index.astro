
---
import MainLayout from "../../layouts/MainLayout.astro";
import games from "../../data/games.json";
import GameCard from "../../components/GameCard.astro";
---

<MainLayout
  title="Hry | LevelUp"
  description="Prozkoumej katalog her na magazínu LevelUp."
  currentPage="games";
>
  
  <main>
    <section class="featured-games" aria-labelledby="games-title">
      <div class="section-heading">
        <div>
          <p class="section-heading__eyebrow">KATALOG</p>
          <h1 id="games-title">Objev svou další hru</h1>
        </div>
        <p class="text-muted">Počet her: {games.length}</p>
      </div>

      <div class="game-grid">
        {games.map((game) => (
          <GameCard game={game} />
        ))}
      </div>
    </section>
  </main>

</MainLayout>
