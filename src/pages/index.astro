
---
import MainLayout from "../layouts/MainLayout.astro";
import games from "../data/games.json";
import GameCard from "../components/GameCard.astro";

---

<MainLayout
  title="LevelUp — Herní magazín"
  description="Herní recenze, novinky a doporučení pro každého hráče."
  currentPage="home";
>

  <main>
    <section class="hero">
      <p class="hero__eyebrow">TVŮJ SVĚT. TVOJE HRY.</p>
      <h1>Objev hry, které <span>stojí za to.</span></h1>
      <p class="hero__description">
        Nezávislé recenze, herní novinky a doporučení pro další dobrodružství.
      </p>

      <a class="hero__button" href="/hry/">Prozkoumat hry</a>
    </section>

    <section class="featured-games" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <p class="section-heading__eyebrow">NÁŠ VÝBĚR</p>
          <h2 id="featured-title">Hry, které doporučujeme</h2>
        </div>

        <a href="/hry/">Všechny hry →</a>
      </div>

      
      <div class="game-grid">
        {[...games]
        .sort((a, b) => b.rating - a.rating)
        .slice(0, 3)
        .map((game) => <GameCard game={game} />)}
      </div>

    </section>

    <section class="about-preview">
      <p class="section-heading__eyebrow">VÍTEJ NA LEVELUP</p>
      <h2>Hraní je víc než jen zábava.</h2>
      <p>
        Pomáháme ti vybírat hry, které stojí za tvůj čas — od velkých
        dobrodružství až po malé nezávislé projekty.
      </p>
      <a href="/clanky/">Přečíst herní články →</a>
    </section>
  </main>

</MainLayout>



