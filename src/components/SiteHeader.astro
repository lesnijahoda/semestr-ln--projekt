---
const { currentPage = "" } = Astro.props;
---

<header class="site-header">
  <a class="site-logo" href="/" aria-label="LevelUp — úvodní stránka">
    Level<span>Up</span>
  </a>

  <button
    class="menu-toggle"
    id="menu-toggle"
    type="button"
    aria-label="Otevřít navigaci"
    aria-expanded="false"
    aria-controls="main-navigation"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="main-nav" id="main-navigation" aria-label="Hlavní navigace">
    <a href="/" aria-current={currentPage === "home" ? "page" : undefined}>
      Domů
    </a>
    <a href="/hry/" aria-current={currentPage === "games" ? "page" : undefined}>
      Hry
    </a>
    <a
      href="/clanky/"
      aria-current={currentPage === "articles" ? "page" : undefined}
    >
      Články
    </a>
    <a
      href="/o-projektu/"
      aria-current={currentPage === "about" ? "page" : undefined}
    >
      O projektu
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById("menu-toggle");
  const nav = document.getElementById("main-navigation");

  if (button && nav) {
    button.addEventListener("click", () => {
  const isOpen = nav.classList.toggle("main-nav--open");

  button.setAttribute("aria-expanded", String(isOpen));
  button.setAttribute(
    "aria-label",
    isOpen ? "Zavřít navigaci" : "Otevřít navigaci"
  );
});
  }
</script>
