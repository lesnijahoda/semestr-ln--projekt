---
import MainLayout from "../../layouts/MainLayout.astro";
import articles from "../../data/articles.json";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<MainLayout
  title={`${article.title} | LevelUp`}
  description={article.excerpt}
  currentPage="articles"
>
  <main class="article-detail">
    <section class="article-hero">
      <img
        class="article-hero__image"
        src={article.image}
        alt=""
        fetchpriority="high"
      />

      <div class="article-hero__overlay">
        <header class="article-detail__header">
          <p class="section-heading__eyebrow">{article.category}</p>
          <h1>{article.title}</h1>
          <p class="article-detail__excerpt">{article.excerpt}</p>

          <div class="article-detail__meta">
            <span>{article.author}</span>
            <span>{article.date}</span>
            <span>{article.readTime} min čtení</span>
          </div>
        </header>
      </div>
    </section>

    <article class="article-detail__body">
      {
        article.content.map((section) => (
          <section>
            <h2>{section.heading}</h2>

            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }

      <a class="article-detail__back" href="/clanky/"> ← Zpět na články </a>
    </article>
  </main>
</MainLayout>
