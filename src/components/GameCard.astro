
---
import RatingBadge from "./RatingBadge.astro";
const { game } = Astro.props;
---

<article class="game-card">
  <div class="game-card__visual" aria-hidden="true">
    <span>LEVELUP</span>
  </div>

  <div class="game-card__content">
    <p class="game-card__genre">{game.genre}</p>

    <h3>{game.title}</h3>

    <p class="game-card__description">
      {game.description}
    </p>

    <div class="game-card__footer">
     <RatingBadge rating={game.rating} />

      <a href={`/hry/${game.slug}/`}>
        Detail hry
      </a>
    </div>
  </div>
</article>
